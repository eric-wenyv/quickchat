# PKGBUILD for quick-chat — run `makepkg -si` from this directory.
# It snapshots the working tree one level up (the repo root), so uncommitted
# changes are included; caches are excluded.
#
# The system rust/nodejs/npm makedepends are the canonical Arch way; if your
# toolchain comes from rustup/mise instead, build with:  makepkg -f --nodeps
#
# Remember to bump pkgver when src-tauri/tauri.conf.json version changes.

pkgname=quick-chat
pkgver=0.1.0
pkgrel=1
pkgdesc='LAN chat application built with Tauri'
arch=('x86_64')
url='https://github.com/eric-wenyv/quickchat'
# no LICENSE file in the repo yet — add one and fill this in
depends=(
  'webkit2gtk-4.1'          # wry webview (also pulls soup3, glib2, cairo, ...)
  'gtk3'
  'openssl'                 # direct DT_NEEDED (libssl/libcrypto)
  'libayatana-appindicator' # tray icon, dlopen'd at runtime
  'hicolor-icon-theme'
)
makedepends=('rust' 'nodejs' 'npm')
# !lto: CFLAGS "-flto=auto" turns the bundled sqlite3.c objects into LTO
# bitcode that rustc drops when linking the sqlx proc-macro, leaving
# libsqlx_macros.so with undefined sqlite3 symbols -> build fails.
options=('!lto')
source=() # built from the local working tree
sha256sums=()

prepare() {
    cd "$srcdir"
    rm -rf "$pkgname"
    mkdir "$pkgname"
    # Snapshot the repo at "$startdir/.." — the parent of this archlinux/ dir.
    # Do NOT put this PKGBUILD in the repo root: makepkg works in ./src and
    # ./pkg, which would collide with the project's own src/ directory.
    tar -C "$startdir/.." \
        --exclude='./.git' \
        --exclude='./archlinux' \
        --exclude='./node_modules' \
        --exclude='./src-tauri/target' \
        --exclude='./dist' \
        -cf - . | tar -C "$pkgname" -xf -
}

build() {
    cd "$srcdir/$pkgname"
    export npm_config_cache="$srcdir/npm-cache"
    # --no-bundle skips deb/rpm/appimage, so none of the linuxdeploy pain applies
    npm ci
    npm run tauri -- build --no-bundle
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 "src-tauri/target/release/quick-chat" -t "$pkgdir/usr/bin/"

    local entry size
    for entry in '32x32:32x32' '128x128:128x128' '128x128@2x:256x256' 'icon:512x512'; do
        size="${entry##*:}"
        install -Dm644 "src-tauri/icons/${entry%%:*}.png" \
            "$pkgdir/usr/share/icons/hicolor/$size/apps/$pkgname.png"
    done

    cat > "$srcdir/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Quick Chat
Comment=LAN chat application
Exec=$pkgname
Icon=$pkgname
Terminal=false
Categories=Network;InstantMessaging;
StartupWMClass=$pkgname
EOF
    install -Dm644 "$srcdir/$pkgname.desktop" -t "$pkgdir/usr/share/applications/"
}
