# PKGBUILD for quick-chat — run `makepkg -si` from this directory.
# It snapshots the working tree one level up (the repo root), so uncommitted
# changes are included; caches are excluded.
#
# The system nodejs/npm makedepends are the canonical Arch way; if your
# toolchain comes from nvm/mise instead, build with:  makepkg -f --nodeps
#
# Remember to bump pkgver when the repo root package.json version changes.

pkgname=quick-chat
pkgver=0.1.0
pkgrel=1
pkgdesc='LAN chat application built with Electron'
arch=('x86_64')
url='https://github.com/eric-wenyv/quickchat'
# no LICENSE file in the repo yet — add one and fill this in
# 运行时共享库：Electron 官方二进制所需（参考 Arch 官方 electron 包的依赖，
# gtk3/nss 等其余依赖由这些包传递引入）
depends=(
  'nss'
  'alsa-lib'
  'gtk3'
  'libxss'
  'libdrm'
  'mesa'
  'libxkbcommon'
  'libxrandr'
  'libxcomposite'
  'libxdamage'
  'libxfixes'
  'libxext'
  'libx11'
  'libxcb'
  'at-spi2-core'
  'pango'
  'cairo'
  'glib2'
  'dbus'
  'expat'
  'hicolor-icon-theme'
)
makedepends=('nodejs' 'npm' 'python') # python: node-gyp 编译 better-sqlite3 备用路径
options=()
source=() # built from the local working tree
sha256sums=()

prepare() {
    cd "$srcdir"
    rm -rf "$pkgname"
    mkdir "$pkgname"
    # Snapshot the repo at "$startdir/.." — the parent of this archlinux/ dir.
    # Do NOT put this PKGBUILD in the repo root: makepkg works in ./src and
    # ./pkg, which would collide with the project's own src/ directory.
    tar -C "$startdir/.." \
        --exclude='./.git' \
        --exclude='./archlinux' \
        --exclude='./node_modules' \
        --exclude='./dist' \
        --exclude='./release' \
        --exclude='./electron-dist' \
        -cf - . | tar -C "$pkgname" -xf -
}

build() {
    cd "$srcdir/$pkgname"
    export npm_config_cache="$srcdir/npm-cache"
    # npmmirror 的 cdn 下载大文件会断流（EOF），用华为云镜像
    export ELECTRON_MIRROR="https://mirrors.huaweicloud.com/electron/"
    npm ci
    npm run build:web
    npm run build:electron-main
    # 只出 unpacked 目录（不打 deb/rpm/appimage，避开 linuxdeploy 依赖链）
    npx electron-builder --linux dir --publish never
}

package() {
    cd "$srcdir/$pkgname"

    install -d "$pkgdir/opt/$pkgname"
    cp -a "release/linux-unpacked/." "$pkgdir/opt/$pkgname/"

    # /usr/bin 入口符号链接
    install -d "$pkgdir/usr/bin"
    ln -s "/opt/$pkgname/quick-chat" "$pkgdir/usr/bin/$pkgname"

    install -Dm644 "electron/assets/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"

    cat > "$srcdir/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Quick Chat
Comment=LAN chat application
Exec=$pkgname
Icon=$pkgname
Terminal=false
Categories=Network;InstantMessaging;
StartupWMClass=$pkgname
EOF
    install -Dm644 "$srcdir/$pkgname.desktop" -t "$pkgdir/usr/share/applications/"
}
