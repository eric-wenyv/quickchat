{
  "name": "quick-chat",
  "private": true,
  "version": "0.1.0",
  "description": "LAN chat application built with Electron",
  "author": {
    "name": "eric",
    "email": "175533312+eric-wenyv@users.noreply.github.com"
  },
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:electron": "npm run build:electron-main && concurrently -k \"npm:dev:web\" \"wait-on http://localhost:1420 && VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
    "dev:fresh": "QUICK_CHAT_DEV_DB=1 npm run dev:electron",
    "dev:web": "vite",
    "build": "npm run build:electron",
    "build:web": "tsc && vite build",
    "build:electron-main": "tsc -p tsconfig.electron.json && node -e \"require('node:fs').cpSync('electron/assets', 'electron-dist/assets', { recursive: true })\"",
    "build:electron": "npm run build:web && npm run build:electron-main && electron-builder",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.quickchat.app",
    "productName": "quick-chat",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^13.0.3",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "mermaid": "^10.9.8",
    "postcss": "^8.5.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/typography": "^0.5.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
