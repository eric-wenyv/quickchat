{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quick-chat",
  "version": "0.1.0",
  "identifier": "com.tauri-app.quick-chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "quick-chat",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": [
            30,
            30,
            30,
            210
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
